{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "spaces-mockup-mcp",
  "main": "worker.py",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "spaces-mockup.mcp.buildermate.ai",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
